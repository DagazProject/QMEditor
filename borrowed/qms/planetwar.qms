#macro:race
  #text:0..0 ''
  #text:1..1 'Человек'
  #text:2..2 'Пеленг'
  #text:3..3 'Малок'
  #text:4..4 'Фэянин'
  #text:5..5 'Гаалец'
#end

#macro:bonus
  #text:0..0 '-1'
  #text:1..1 ''
  #text:2..2 '+1'
  #text:3..3 '+2'
#end

#macro:chars:NM
#var:[$NM] #range:0..16383 #default:0 #mod:4 #hide
  #field:science      // 4096 Эффективность исследований
  #field:spy          // 1024 Эффективность разведки
  #field:defence      // 256  Эффективность защиты
  #field:attack       // 64   Эффективность атаки
  #field:chaotic      // 16   Хаотичность
  #field:production   // 4    Эффективность производства
  #field:reproduction // 1    Воспроизводство населения
#end

#var:frace #range:0..5 #default:0 #hide
  #race
#var:erace #range:0..5 #default:0 #hide
  #race

#chars:echars // Характеристики противника
#chars:fchars // Характеристики игрока

#var:temp_1 #range:0..1000000 #default:3 #hide
  #bonus
#var:temp_2 #range:0..1000000 #default:3 #hide
  #bonus
#var:temp_3 #range:0..1000000 #default:3 #hide
  #bonus
#var:temp_4 #range:0..1000000 #default:3 #hide
  #bonus
#var:temp_5 #range:0..1000000 #default:3 #hide
  #bonus
#var:temp_6 #range:0..1000000 #default:3 #hide
  #bonus
#var:temp_7 #range:0..1000000 #default:3 #hide
  #bonus
#var:temp_8 #range:0..1000000 #default:0 #hide

#var:year #range:3027..4027 #default:3027

#var:ebonus #range:0..3 #default:0 #hide // Нераспределённые бонусы противника
#var:fbonus #range:0..3 #default:0 #hide // Нераспределённые бонусы игрока

#var:variant #range:0..1000 #default:0 #hide // Вариант выбора

#site:entry #default
#page:1
Planet War
#case:start 'Играть'
#case:mancala_init { 1 = 0 } 'Манкала'
$variant = <1..2>
#case:lightoff_init { 1 = 0 } 'Туши свет'
$variant = <3..9>
#case:solit_init { 1 = 0 } 'Солитер'
$variant = <10..12>

#site:start
$erace               = <1..5>
$echars              = 0
$fchars              = 0
#page:1
Выбрать расу
#case:race 'Человек' {$erace <> 1}
$frace               = 1 // Человек
$fchars              = 7573
$fbonus              = 2 // +2
#case:race 'Пеленг'  {$erace <> 2}
$frace               = 2 // Пеленг
$fchars              = 7766
$fbonus              = 1 // +1
#case:race 'Малок'   {$erace <> 3}
$frace               = 3 // Малок
$fchars              = 1525
$fbonus              = 2 // +2
#case:race 'Фэянин'  {$erace <> 4}
$frace               = 4 // Фэянин
$fchars              = 6937
$fbonus              = 2 // +2
#case:race 'Гаалец'  {$erace <> 5}
$frace               = 5 // Гаалец
$fchars              = 15125
$fbonus              = 1 // +1

#macro:raim:L
$temp_1 = $[$L]chars.reproduction
$temp_2 = $[$L]chars.production
$temp_3 = $[$L]chars.chaotic
$temp_4 = $[$L]chars.attack
$temp_5 = $[$L]chars.defence
$temp_6 = $[$L]chars.spy
$temp_7 = $[$L]chars.science
#page:1
^ Раса: @[$L]race ^
^ -------------------------------------- ^
^ Воспроизводство:  @temp_1 ^
^ Производство:     @temp_2 ^
^ Хаотичность:      @temp_3 ^
^ Атака:            @temp_4 ^
^ Защита:           @temp_5 ^
^ Шпионаж:          @temp_6 ^
^ Наука:            @temp_7 ^
^ -------------------------------------- ^
^ Не распределено:  $[$L]bonus ^
#end

#site:race
#raim:f
#case:inc 'Увеличить' { $fbonus > 0 } #order:1
#case:dec 'Уменьшить' #order:2
#case:rand_3 'Играть' { $fbonus = 0 and $erace = 1 } #order:3
$echars = 7573
$ebonus = 2 
#case:rand_3 'Играть' { $fbonus = 0 and $erace = 2 } #order:3
$echars = 7766
$ebonus = 1
#case:rand_3 'Играть' { $fbonus = 0 and $erace = 3 } #order:3
$echars = 1525
$ebonus = 2
#case:rand_3 'Играть' { $fbonus = 0 and $erace = 4 } #order:3
$echars = 6937
$ebonus = 2
#case:rand_3 'Играть' { $fbonus = 0 and $erace = 5 } #order:3
$echars = 15125
$ebonus = 1
#case:rand_1 'Распределить случайно' { $fbonus > 0 } #order:4
#case:start 'Выбрать другую расу' #order:5

#site:inc
#raim:f
#case:race 'Воспроизводство' { $fchars.reproduction < 3 } #order:1
$fchars.reproduction = $fchars.reproduction + 1
$fbonus = $fbonus - 1
#case:race 'Производство' { $fchars.production < 3 } #order:2
$fchars.production = $fchars.production + 1
$fbonus = $fbonus - 1
#case:race 'Хаотичность' { $fchars.chaotic < 3 } #order:3
$fchars.chaotic = $fchars.chaotic + 1
$fbonus = $fbonus - 1
#case:race 'Атака' { $fchars.attack < 3 } #order:4
$fchars.attack = $fchars.attack + 1
$fbonus = $fbonus - 1
#case:race 'Защита' { $fchars.defence < 3 } #order:5
$fchars.defence = $fchars.defence + 1
$fbonus = $fbonus - 1
#case:race 'Шпионаж' { $fchars.spy < 3 } #order:6
$fchars.spy = $fchars.spy + 1
$fbonus = $fbonus - 1
#case:race 'Наука' { $fchars.science < 3 } #order:7
$fchars.science = $fchars.science + 1
$fbonus = $fbonus - 1
#case:race 'Вернуться' #order:8

#site:dec
#raim:f
#case:race 'Воспроизводство' { $fchars.reproduction > 0 } #order:1
$fchars.reproduction = $fchars.reproduction - 1
$fbonus = $fbonus + 1
#case:race 'Производство' { $fchars.production > 0 } #order:2
$fchars.production = $fchars.production - 1
$fbonus = $fbonus + 1
#case:race 'Хаотичность' { $fchars.chaotic > 0 } #order:3
$fchars.chaotic = $fchars.chaotic - 1
$fbonus = $fbonus + 1
#case:race 'Атака' { $fchars.attack > 0 } #order:4
$fchars.attack = $fchars.attack - 1
$fbonus = $fbonus + 1
#case:race 'Защита' { $fchars.defence > 0 } #order:5
$fchars.defence = $fchars.defence - 1
$fbonus = $fbonus + 1
#case:race 'Шпионаж' { $fchars.spy > 0 } #order:6
$fchars.spy = $fchars.spy - 1
$fbonus = $fbonus + 1
#case:race 'Наука' { $fchars.science > 0 } #order:7
$fchars.science = $fchars.science - 1
$fbonus = $fbonus + 1
#case:race 'Вернуться' #order:8

#site:rand_1
#case:race { $fbonus = 0 }
#case:rand_2 { $fbonus > 0 }

#site:rand_2
$variant = <1..7>
#case:rand_1 { $variant = 1 and $fchars.reproduction = 3 }
#case:rand_1 { $variant = 1 and $fchars.reproduction < 3 }
$fchars.reproduction = $fchars.reproduction + 1
$fbonus = $fbonus - 1
#case:rand_1 { $variant = 2 and $fchars.production = 3 }
#case:rand_1 { $variant = 2 and $fchars.production < 3 }
$fchars.production = $fchars.production + 1
$fbonus = $fbonus - 1
#case:rand_1 { $variant = 3 and $fchars.chaotic = 3 }
#case:rand_1 { $variant = 3 and $fchars.chaotic < 3 }
$fchars.chaotic = $fchars.chaotic + 1
$fbonus = $fbonus - 1
#case:rand_1 { $variant = 4 and $fchars.attack = 3 }
#case:rand_1 { $variant = 4 and $fchars.attack < 3 }
$fchars.attack = $fchars.attack + 1
$fbonus = $fbonus - 1
#case:rand_1 { $variant = 5 and $fchars.defence = 3 }
#case:rand_1 { $variant = 5 and $fchars.defence < 3 }
$fchars.defence = $fchars.defence + 1
$fbonus = $fbonus - 1
#case:rand_1 { $variant = 6 and $fchars.spy = 3 }
#case:rand_1 { $variant = 6 and $fchars.spy < 3 }
$fchars.spy = $fchars.spy + 1
$fbonus = $fbonus - 1
#case:rand_1 { $variant = 7 and $fchars.science = 3 }
#case:rand_1 { $variant = 7 and $fchars.science < 3 }
$fchars.science = $fchars.science + 1
$fbonus = $fbonus - 1

#site:rand_3
#case:init { $ebonus = 0 }
#case:rand_4 { $ebonus > 0 }

#site:rand_4
$variant = <1..7>
#case:rand_3 { $variant = 1 and $echars.reproduction = 3 }
#case:rand_3 { $variant = 1 and $echars.reproduction < 3 }
$echars.reproduction = $echars.reproduction + 1
$ebonus = $ebonus - 1
#case:rand_3 { $variant = 2 and $echars.production = 3 }
#case:rand_3 { $variant = 2 and $echars.production < 3 }
$echars.production = $echars.production + 1
$ebonus = $ebonus - 1
#case:rand_3 { $variant = 3 and $echars.chaotic = 3}
#case:rand_3 { $variant = 3 and $echars.chaotic < 3}
$echars.chaotic = $echars.chaotic + 1
$ebonus = $ebonus - 1
#case:rand_3 { $variant = 4 and $echars.attack = 3 }
#case:rand_3 { $variant = 4 and $echars.attack < 3 }
$echars.attack = $echars.attack + 1
$ebonus = $ebonus - 1
#case:rand_3 { $variant = 5 and $echars.defence = 3 }
#case:rand_3 { $variant = 5 and $echars.defence < 3 }
$echars.defence = $echars.defence + 1
$ebonus = $ebonus - 1
#case:rand_3 { $variant = 6 and $echars.spy = 3 }
#case:rand_3 { $variant = 6 and $echars.spy < 3 }
$echars.spy = $echars.spy + 1
$ebonus = $ebonus - 1
#case:rand_3 { $variant = 7 and $echars.science = 3 }
#case:rand_3 { $variant = 7 and $echars.science < 3 }
$echars.science = $echars.science + 1
$ebonus = $ebonus - 1

#macro:planet
  #text:0..0 ''
  #text:1..1 'Кабруния'
  #text:2..2 'Катраз'
  #text:3..3 'Авалон'
  #text:4..4 'Гралгар'
  #text:5..5 'Велорат'
  #text:6..6 'Дралимия'
#end

#macro:ptype
  #text:0..0 ''
  #text:1..1 'Столица'
#end

#macro:pop:NN
#var:pop_[$NN] #range:0..1000000000 #default:32001 #hide
  #field:total #mod:10000000
  #field:science #mod:8
  #field:capital #mod:2
  #field:friend #mod:2
#end

#macro:arm:NN
#var:arm_[$NN] #range:0..1000000000 #default:0 #hide
  #field:arty #mod:1000
  #field:navy #mod:1000
  #field:land #mod:1000
#end

#macro:transfer:NN
#var:transfer_[$NN] #range:0..1000000000 #default:0 #hide
  #field:popl #mod:1000
  #field:navy #mod:1000
  #field:land #mod:1000
#end

#for:i:1..6
  #pop:[$i]
  #arm:[$i]
  #transfer:[$i]
#end

#var:curr #range:1..6 #default:1 #hide
  #planet

#macro:paim
^ Планета: @curr (Год: $year) ^
^ -------------------------------------- ^
^ Население:  $temp_1 ^
^ Пехота:     $temp_2 ^
^ Авиация:    $temp_3 ^
^ Артиллерия: $temp_4 ^
^ Учёные:     $temp_6 ^
//^ Разведка:   $temp_5 ^
#end

#site:init
$pop_1 = ((($fchars.chaotic - 1) * <1..10>) + 1000) * 32 + 1
$pop_2 = ((($fchars.chaotic - 1) * <1..10>) +  100) * 32 + 1
$pop_3 = ((($fchars.chaotic - 1) * <1..10>) +  100) * 32 + 1
$pop_4 = ((($fchars.chaotic - 1) * <1..10>) + 1000) * 32
$pop_5 = ((($fchars.chaotic - 1) * <1..10>) +  100) * 32
$pop_6 = ((($fchars.chaotic - 1) * <1..10>) +  100) * 32
#case:game

#site:game
#case:main { $curr = 1 }
$temp_1 = $pop_1.total
$temp_2 = $arm_1.land
$temp_3 = $arm_1.navy
$temp_4 = $arm_1.arty
//$temp_5 = $transfer_1.spy
$temp_6 = $pop_1.science
#case:main { $curr = 2 }
$temp_1 = $pop_2.total
$temp_2 = $arm_2.land
$temp_3 = $arm_2.navy
$temp_4 = $arm_2.arty
//$temp_5 = $transfer_2.spy
$temp_6 = $pop_2.science
#case:main { $curr = 3 }
$temp_1 = $pop_3.total
$temp_2 = $arm_3.land
$temp_3 = $arm_3.navy
$temp_4 = $arm_3.arty
//$temp_5 = $transfer_3.spy
$temp_6 = $pop_3.science
#case:main { $curr = 4 }
$temp_1 = $pop_4.total
$temp_2 = $arm_4.land
$temp_3 = $arm_4.navy
$temp_4 = $arm_4.arty
//$temp_5 = $transfer_4.spy
$temp_6 = $pop_4.science
#case:main { $curr = 5 }
$temp_1 = $pop_5.total
$temp_2 = $arm_5.land
$temp_3 = $arm_5.navy
$temp_4 = $arm_5.arty
//$temp_5 = $transfer_5.spy
$temp_6 = $pop_5.science
#case:main { $curr = 6 }
$temp_1 = $pop_6.total
$temp_2 = $arm_6.land
$temp_3 = $arm_6.navy
$temp_4 = $arm_6.arty
//$temp_5 = $transfer_6.spy
$temp_6 = $pop_6.science

#site:main
#page:1
#paim
#case:select 'Другая планета'                        #order:1
#case:train  'Тренировать'                           #order:2
$temp_8 = 0
#case:transf 'Переместить'                           #order:3
//#case:attack 'Атаковать'    { $temp_2 + $temp_3 > 0} #order:4
//#case:scienc 'Исследования' { $temp_6 > 0 }          #order:5
//#case:intelg 'Разведка'     { $temp_5 > 0 }          #order:6
#case:wait   'Ждать'                                 #order:7

#site:select
#page:1
#paim
#case:game 'Кабруния' { $pop_1.friend = 1 and $curr <> 1 } #order:1
$curr = 1
#case:game 'Катраз' { $pop_2.friend = 1 and $curr <> 2 } #order:2
$curr = 2
#case:game 'Авалон' { $pop_3.friend = 1 and $curr <> 3 } #order:3
$curr = 3
#case:game 'Гралгар' { $pop_4.friend = 1 and $curr <> 4 } #order:4
$curr = 4
#case:game 'Велорат' { $pop_5.friend = 1 and $curr <> 5 } #order:5
$curr = 5
#case:game 'Дралимия' { $pop_6.friend = 1 and $curr <> 6 } #order:6
$curr = 6
#case:main 'Вернуться' #order:7

#site:train
#page:1
#paim
#case:train_what 'Пехоту' #order:1
$variant = 1
$temp_7  = 4 + $fchars.production
#case:train_what 'Авиацию' #order:2
$variant = 2
$temp_7  = 3 + $fchars.production
#case:train_what 'Артиллерию' #order:3
$variant = 3
$temp_7  = 2 + $fchars.production
#case:train_what 'Учёных' #order:4
$variant = 4
#case:main 'Вернуться' #order:7

#site:train_what { $variant }
#page:1
#paim
^ -------------------------------------- ^
^ Пехота:     $temp_8 ^
#page:2
#paim
^ -------------------------------------- ^
^ Авиация:    $temp_8 ^
#page:3
#paim
^ -------------------------------------- ^
^ Артиллерия: $temp_8 ^
#page:4
#paim
^ -------------------------------------- ^
^ Учёные:     $temp_8 ^
#case:train_what 'Одного' { $temp_1 > 0 and $variant < 4 and ($temp_8 + 1) <= ((($temp_1 - 1) * $temp_7) div 100) } #order:1
$temp_8 = $temp_8 + 1
$temp_1 = $temp_1 - 1
#case:train_what 'Одного' { $temp_1 > 0 and $variant >= 4 and $temp_8 < 5 } #order:1
$temp_8 = $temp_8 + 1
$temp_1 = $temp_1 - 100
#case:train_what 'Десяток' { $temp_1 > 10 and $variant < 4  and ($temp_8 + 10) <= ((($temp_1 - 10) * $temp_7) div 100) } #order:2
$temp_8 = $temp_8 + 10
$temp_1 = $temp_1 - 10
#case:train_temp 'Обучить' { $temp_8 > 0 } #order:3
#case:main 'Отменить обучение' { $variant < 4 } #order:7
$temp_1 = $temp_1 + $temp_8
#case:main 'Отменить обучение' { $variant >= 4 } #order:7
$temp_1 = $temp_1 + ($temp_8 * 100)

#site:train_temp
#case:main { $curr = 1 and $variant = 1 }
$transfer_1.land = $transfer_1.land + $temp_8
$temp_8 = 0
#case:main { $curr = 1 and $variant = 2 }
$transfer_1.navy = $transfer_1.navy + $temp_8
$temp_8 = 0
#case:main { $curr = 1 and $variant = 3 }
$arm_1.arty = $arm_1.arty + $temp_8
$temp_8 = 0
#case:main { $curr = 1 and $variant = 4 }
$pop_1.science = $pop_1.science + $temp_8
$temp_8 = 0
#case:main { $curr = 2 and $variant = 1 }
$transfer_2.land = $transfer_2.land + $temp_8
$temp_8 = 0
#case:main { $curr = 2 and $variant = 2 }
$transfer_2.navy = $transfer_2.navy + $temp_8
$temp_8 = 0
#case:main { $curr = 2 and $variant = 3 }
$arm_2.arty = $arm_2.arty + $temp_8
$temp_8 = 0
#case:main { $curr = 2 and $variant = 4 }
$pop_2.science = $pop_2.science + $temp_8
$temp_8 = 0
#case:main { $curr = 3 and $variant = 1 }
$transfer_3.land = $transfer_3.land + $temp_8
$temp_8 = 0
#case:main { $curr = 3 and $variant = 2 }
$transfer_3.navy = $transfer_3.navy + $temp_8
$temp_8 = 0
#case:main { $curr = 3 and $variant = 3 }
$arm_3.arty = $arm_3.arty + $temp_8
$temp_8 = 0
#case:main { $curr = 3 and $variant = 4 }
$pop_3.science = $pop_3.science + $temp_8
$temp_8 = 0
#case:main { $curr = 4 and $variant = 1 }
$transfer_4.land = $transfer_4.land + $temp_8
$temp_8 = 0
#case:main { $curr = 4 and $variant = 2 }
$transfer_4.navy = $transfer_4.navy + $temp_8
$temp_8 = 0
#case:main { $curr = 4 and $variant = 3 }
$arm_4.arty = $arm_4.arty + $temp_8
$temp_8 = 0
#case:main { $curr = 4 and $variant = 4 }
$pop_4.science = $pop_4.science + $temp_8
$temp_8 = 0
#case:main { $curr = 5 and $variant = 1 }
$transfer_5.land = $transfer_5.land + $temp_8
$temp_8 = 0
#case:main { $curr = 5 and $variant = 2 }
$transfer_5.navy = $transfer_5.navy + $temp_8
$temp_8 = 0
#case:main { $curr = 5 and $variant = 3 }
$arm_5.arty = $arm_5.arty + $temp_8
$temp_8 = 0
#case:main { $curr = 5 and $variant = 4 }
$pop_5.science = $pop_5.science + $temp_8
$temp_8 = 0
#case:main { $curr = 6 and $variant = 1 }
$transfer_6.land = $transfer_6.land + $temp_8
$temp_8 = 0
#case:main { $curr = 6 and $variant = 2 }
$transfer_6.navy = $transfer_6.navy + $temp_8
$temp_8 = 0
#case:main { $curr = 6 and $variant = 3 }
$arm_6.arty = $arm_6.arty + $temp_8
$temp_8 = 0
#case:main { $curr = 6 and $variant = 4 }
$pop_6.science = $pop_6.science + $temp_8
$temp_8 = 0

#macro:taim
^ Планета: @curr (Год: $year) ^
^ -------------------------------------- ^
^ Население:  $temp_1 ^
^ Пехота:     $temp_2 ^
^ Авиация:    $temp_3 ^
#end

#site:transf
#page:1
#taim
#case:transf_num 'Население' { $temp_1 > 0 } #order:1
$variant = 1
#case:transf_num 'Пехоту' { $temp_2 > 0 } #order:2
$variant = 2
#case:transf_num 'Авиацию' { $temp_3 > 0 } #order:2
$variant = 3
#case:main 'Вернуться' #order:7

#site:transf_num { $variant }
#page:1
#taim
^ -------------------------------------- ^
^ Население:  $temp_8 ^
#page:2
#taim
^ -------------------------------------- ^
^ Пехота:     $temp_8 ^
#page:3
#taim
^ -------------------------------------- ^
^ Авиация:    $temp_8 ^
#case:transf_temp 'Одного' { $variant = 1 and $temp_1 > 0 } #order:1
$temp_1 = $temp_1 - 1
$temp_8 = $temp_8 + 1
#case:transf_temp 'Одного' { $variant = 2 and $temp_2 > 0 } #order:1
$temp_2 = $temp_2 - 1
$temp_8 = $temp_8 + 1
#case:transf_temp 'Одного' { $variant = 3 and $temp_3 > 0 } #order:1
$temp_3 = $temp_3 - 1
$temp_8 = $temp_8 + 1
#case:transf_temp 'Десяток' { $variant = 1 and $temp_1 > 10 } #order:2
$temp_1 = $temp_1 - 10
$temp_8 = $temp_8 + 10
#case:transf_temp 'Десяток' { $variant = 2 and $temp_2 > 10 } #order:2
$temp_2 = $temp_2 - 10
$temp_8 = $temp_8 + 10
#case:transf_temp 'Десяток' { $variant = 3 and $temp_3 > 10 } #order:2
$temp_3 = $temp_3 - 10
$temp_8 = $temp_8 + 10
#case:transf_temp 'Всех' { $variant = 1 and $temp_1 > 1 and $temp_1 <= 1000 } #order:3
$temp_8 = $temp_8 + $temp_1
$temp_1 = 0
#case:transf_temp 'Всех' { $variant = 2 and $temp_2 > 1 and $temp_2 <= 1000 } #order:3
$temp_8 = $temp_8 + $temp_2
