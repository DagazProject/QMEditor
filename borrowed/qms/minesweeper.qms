#var:rA #range:0..99999999 #default:0 #hide
#var:rB #range:0..99999999 #default:0 #hide
#var:rC #range:0..99999999 #default:0 #hide

#macro:mine:ix
  #var:mn[$ix] #range:0..99999999 #mod:100 #hide
    #field:A
    #field:B
    #field:C
    #field:D
#end

#for:i:0..3
  #mine:[$i]
#end

#var:col #range:-1..7 #default:-1 #hide
  #text:-1..-1 '^  A B C D E F G H ^'
  #text:0..0   '^  * B C D E F G H ^'
  #text:1..1   '^  A * C D E F G H ^'
  #text:2..2   '^  A B * D E F G H ^'
  #text:3..3   '^  A B C * E F G H ^'
  #text:4..4   '^  A B C D * F G H ^'
  #text:5..5   '^  A B C D E * G H ^'
  #text:6..6   '^  A B C D E F * H ^'
  #text:7..7   '^  A B C D E F G * ^'
#var:row #range:-1..5 #default:-1 #hide

#macro:cell:A:B:DF
  #var:cl[$A][$B] #range:0..99 #default:[$DF] #mod:10 #hide // default не работает
    #field:H
      #text:0..0 ' '
      #text:1..1 '1'
      #text:2..2 '2'
      #text:3..3 '3'
      #text:4..4 '4'
      #text:5..5 '5'
      #text:6..6 '6'
      #text:7..7 '7'
      #text:8..8 '8'
      #text:9..9 '.'
    #field:L
      #text:0..0 '  '
      #text:1..1 ' 1'
      #text:2..2 ' 2'
      #text:3..3 ' 3'
      #text:4..4 ' 4'
      #text:5..5 ' 5'
      #text:6..6 ' 6'
      #text:7..7 ' 7'
      #text:8..8 ' 8'
      #text:9..9 ' .'
#end

#for:y:0..6
  #for:x:0..3
    #cell:[$y]:[$x]:99
  #end
#end

#macro:aim
#page:1
^+-----------------+^
^| @cl00 @cl01 @cl02 @cl03 |^ %7%
^| @cl10 @cl11 @cl12 @cl13 |^ %6%
^| @cl20 @cl21 @cl22 @cl23 |^ %5%
^| @cl30 @cl31 @cl32 @cl33 |^ %4%
^| @cl40 @cl41 @cl42 @cl43 |^ %3%
^| @cl50 @cl51 @cl52 @cl53 |^ %2%
^| @cl60 @cl61 @cl62 @cl63 |^ %1%
^+-----------------+^
@col
#end

#site:entry #default
#aim
#case:init 'Старт'

// Расстановка мин
#site:init
#case:setup #return:init_1
#site:init_1
$mn0=$rA
#case:setup #return:init_2
#site:init_2
$mn1=$rA
#case:setup #return:init_3
#site:init_3
$mn2=$rA
#case:setup #return:init_4
#site:init_4
$mn3=$rA
#case:view

